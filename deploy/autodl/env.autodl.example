# =============================================================================
# AutoDL 私有化部署专用环境变量模板
# -----------------------------------------------------------------------------
# 用法（仓库根目录执行）：
#     cp deploy/autodl/env.autodl.example .env
#     # 然后至少修改 MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD
#
# 与 .env.example 的 4 处关键差异（就地说明，避免踩坑）：
#   1) LLM 从 DashScope 云端切到「本机 vLLM/SGLang」的 OpenAI 兼容端点。
#      代码侧 modules/rag/pipeline.py 用的是 ChatOpenAI(base_url=s.dashscope_base_url)，
#      所以改 base_url 即可，业务代码零改动。端口用 8001，避免和 backend(6006/8000) 撞。
#   2) ⚠️ 必设 NO_PROXY：modules/rag/dashscope_http.py 里 httpx 用了 trust_env=True，
#      会自动读取 HTTP(S)_PROXY 环境变量。若不排除 127.0.0.1，
#      「本机 LLM 调用」会被代理劫持并失败。
#   3) 本地嵌入/重排强制走 GPU：EMBEDDING_DEVICE / RERANK_DEVICE 都设为 cuda。
#      （README「显存预算」给出三模型同卡的分配依据）
#   4) 基础设施按「后端原生跑 + 中间件 Docker 跑」对齐为 127.0.0.1。
# =============================================================================

# ---------- ① LLM：指向本机 vLLM / SGLang（本文件最关键改动）----------
DASHSCOPE_API_KEY=sk-autodl-local
DASHSCOPE_BASE_URL=http://127.0.0.1:8001/v1
# 必须与 vLLM 启动参数 --served-model-name 完全一致，否则 404 model not found
LLM_MODEL=Qwen3.8-27B-FP8
# 本机只有一个模型时，意图模型指向同一个即可（意图只做 true/false 分类）
INTENT_MODEL=Qwen3.8-27B-FP8
LLM_FALLBACK_MESSAGE=抱歉，回答生成服务暂时不可用，请稍后重试。

# ---------- ② 本地嵌入 / 重排：三模型同卡，全部上 GPU ----------
EMBEDDING_MODEL_PATH=models/bge-m3
RERANK_MODEL_PATH=models/bge-reranker-large
EMBEDDING_DEVICE=cuda:0
RERANK_DEVICE=cuda
# 父文档重排候选池（生产默认 12）
RERANK_POOL_TOP_N=12
RERANK_TIMEOUT_SECONDS=30

# ---------- ③ 中间件（由 Docker 起，端口映射到宿主 127.0.0.1）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xiaoyi
MYSQL_PASSWORD=change_me_autodl
MYSQL_DATABASE=xiaoyi_rag
# 仅 docker-compose.autodl.yml 使用（root 密码），后端不读这一项
MYSQL_ROOT_PASSWORD=change_me_root
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# ★ Milvus Lite（无 Docker 环境专用）：填本地文件路径即启用本地向量库；
#   留空则回退上面的 host/port 连接（原行为）。
#   ⚠️ key 必须叫 MILVUS_LITE_URI，**不能**写成 MILVUS_URI ——
#      MILVUS_URI 是 pymilvus 自身的环境变量，它会在 import 阶段从 cwd 的 .env
#      读取并校验成 http(s):// 形式，用本地路径会让 `import pymilvus` 直接抛异常。
MILVUS_LITE_URI=

# ---------- ④ 检索契约（必须与冻结资产一致，勿随意改）----------
RETRIEVAL_CONTRACT=v2
RETRIEVAL_V2_COLLECTION=xiaoyi_legal_child_v2
CANONICAL_MANIFEST_PATH=data/manifests/ingest_manifest_v2_live.jsonl
# 复现 V2 时保持 false：避免后台全量扫库任务干扰本次验证
HOT_UPDATE_ENABLED=false
HOT_UPDATE_INTERVAL_SECONDS=0

# ---------- ⑤ 混合检索 / 重排 / FAQ（沿用生产默认值）----------
LEGAL_HYBRID_BM25_ENABLED=true
HYBRID_DENSE_CANDIDATE_K=60
HYBRID_BM25_CANDIDATE_K=60
HYBRID_RRF_K=60
FAQ_DIRECT_DIST_THRESH=0.01
FAQ_LLM_DIST_THRESH=0.15
FAQ_TOP_K_FOR_LLM=3
LEGAL_RERANK_TOP_N=5
CACHE_TTL_SECONDS=3600

# ---------- ⑥ 语义缓存 / 限流（保持生产默认）----------
# 语义缓存已标定存在「章/节」近义误命中风险，默认关闭
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.97
SEMANTIC_CACHE_MAX_ENTRIES=200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- ⑦ ⚠️ 必设：代理绕行（见文件头第 2 条）----------
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1

# ---------- ⑧ CORS：前端来源白名单 ----------
# 用 AutoDL 公网地址访问前端时，把该地址追加进来（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
