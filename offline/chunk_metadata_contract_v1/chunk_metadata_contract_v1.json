    "INV1.2": "chunk_id matches contract rule (deep determinism)",
    "INV2":  "document_id non-empty",
    "INV3":  "source_file non-empty, source_sha256 64-hex, chunk_index >= 0",
    "INV4":  "source_block_orders non-empty (provenance mandatory)",
    "INV5":  "source_block_orders strictly monotonic",
    "INV6":  "no duplicate block orders",
    "INV7":  "start/end order consistent with min/max",
    "INV8":  "page_start <= page_end when both exist",
    "INV9":  "every page_number inside [page_start, page_end]",
    "INV10": "chapter/section/article nullable, non-empty if set, no whitespace pseudo-nulls",
    "INV11": "sentinel values forbidden in any public field",
    "INV12": "strict schema: extras must be empty dict",
    "INV13": "TABLE structure internally consistent + table orders subset of provenance",
    "INV14": "parent_chunk_id optional (when present, correct format); chunk_level vocabulary valid",
    "INV15": "no document metadata semantic overwrite / no fabrication / sentinel rejected",
    "INV16": "metadata round-trip serialization stable (to_dict -> from_dict)",
    "INV17": "chunk_id determinism against runtime-computed contract id"
  },
  "document_metadata_projection": {
