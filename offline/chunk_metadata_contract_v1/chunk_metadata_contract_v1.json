  "chunk_id_contract": {
    "algorithm": "SHA256 hex-prefix 32 chars",
    "input_fields": [
      "CMCV1",
      "source_sha256",
      "document_id",
      "chunk_index",
      "original_block_order_start",
      "original_block_order_end"
    ],
    "input_joined_by": "|",
    "output_format": "lowercase-hex length 32",
    "reference_impl": "compute_chunk_id_contract in chunk_metadata_contract_v1.py"
  },
  "forbidden_sentinel_strings": [
    "__UNSET__",
    "__UNKNOWN__",
    "__METADATA_BLOCK_VALUE__",
    "__REVIEW_BLOCK__",
    "__REVIEW__"
  ],
  "allowed_enums": {
