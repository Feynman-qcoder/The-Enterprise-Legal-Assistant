# =============================================================================
# 教学说明：本文件在整体链路中的位置
# -----------------------------------------------------------------------------
# 输入：无（这是模板文本）；复制为 `.env` 后由人工填写真实密钥与密码。
# 输出：运行时 `pydantic-settings` 按变量名读入进程环境；键名须与 `config.py` 里 alias 一致。
# 被谁调用：不「执行」本文件；运维/学员复制为 `.env` 后，`get_settings()` 自动加载。
# 逐行：每行 KEY=value 表示一个环境变量；# 开头为注释；空值表示留空或使用代码内 default。
# =============================================================================

# 阿里云 DashScope API Key（必填才能走意图 + 主模型；空则意图降级为默认专业）
# 获取地址：https://bailian.console.aliyun.com → API-KEY 管理
DASHSCOPE_API_KEY=

# MySQL 连接（与 `scripts/init_mysql.sql` 建库信息一致；先执行该 SQL 建库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xiaoyi
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=xiaoyi_rag

# Redis 连接 URL（含库号 0；与 `deploy/docker-compose.yml` 中 redis 端口一致）
REDIS_URL=redis://127.0.0.1:6379/0

# Milvus 向量库地址（standalone 容器默认映射 19530）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 可选：启用 Milvus Lite（无法运行 Docker 的环境才需要，如 AutoDL 等嵌套容器）。
# 留空（默认）= 按上方 host/port 连接，行为与不设置完全一致。
# ⚠️ 必须写 MILVUS_LITE_URI，不要写成 MILVUS_URI：后者是 pymilvus 自身的
#    环境变量，pymilvus 会在 import 阶段从当前工作目录的 .env 读取并校验它，
#    只接受 http(s):// 形式，传本地路径会导致连 import pymilvus 都失败。
# MILVUS_LITE_URI=/root/autodl-tmp/milvus.db

# 法律检索数据契约：v2 = 冻结资产复现链路（README Quickstart 推荐）；
# legacy_v1 = 旧 legal_tab 链路（需另行灌入 Legacy 数据，开源复现不涉及）
RETRIEVAL_CONTRACT=v2
RETRIEVAL_V2_COLLECTION=xiaoyi_legal_child_v2

# ---------- 对话记忆模块（无独立环境变量）----------
# 用户与聊天历史表 users_tab / his_chat_tab 使用上方 MYSQL_* 连接，由应用启动 create_all 建表。
# API 通过请求体 user_external_id 绑定用户。

# true：后台按间隔把 MySQL 全量同步到 Milvus（Legacy 链路用；V2 复现保持 false）
HOT_UPDATE_ENABLED=false
# <=0 时回退为 60 秒一轮（见 config.effective_hot_update_interval_seconds）
HOT_UPDATE_INTERVAL_SECONDS=0

# ---------- 素材问答（上传图片/文件 → 提取文本 → 作为上下文；默认整体关闭）----------
# 总开关：false（默认）时 POST /api/chat/stream-with-attachment 返回 503，现有功能不受影响
ATTACHMENT_ENABLED=false
# 图片识别用的多模态模型（复用上方 DASHSCOPE_BASE_URL / DASHSCOPE_API_KEY，零新增凭证）
VISION_MODEL=deepseek-v4.1-flash
# 单文件上传上限（字节），默认 10MB（实测 9MB 图可正常识别）
ATTACHMENT_MAX_BYTES=10485760
# 提取（图片识别/文档解析）超时秒数（实测图片识别 2.4~13.1s）
ATTACHMENT_TIMEOUT_SECONDS=60
# 提取文本低于此字符数判失败（fail-closed，不进入生成）
ATTACHMENT_MIN_TEXT_CHARS=20
# 素材文本注入提示词的字符上限；超出截断并在 transcription 事件中告知（民法典全文 16.5 万字符会触发）
ATTACHMENT_CONTEXT_MAX_CHARS=60000

# ---------- 引用核查（回答里的法条引用逐条与本次证据比对；观察模式，只报告不改答案；默认关闭）----------
# 总开关：false（默认）时不提取/不验证/不发 citation_report 事件，SSE 输出与现状逐字节一致
CITATION_CHECK_ENABLED=false
# 引文文本相似度阈值（滑窗 difflib）；低于阈值判 text_mismatch。数字守卫先于此生效：
# 引文中的金额/比例/期限数字在证据中不存在时直接判 text_mismatch（法律文本对数字最敏感）
CITATION_CHECK_TEXT_THRESHOLD=0.8

# 法律检索是否启用 BM25 一路 + RRF 融合
LEGAL_HYBRID_BM25_ENABLED=true
# 向量路、BM25 路各自候选规模与 RRF 平滑系数
HYBRID_DENSE_CANDIDATE_K=60
HYBRID_BM25_CANDIDATE_K=60
HYBRID_RRF_K=60

# 本地模型目录（相对仓库根）；须事先下载权重到对应文件夹（README「模型权重下载」）
EMBEDDING_MODEL_PATH=models/bge-m3
RERANK_MODEL_PATH=models/bge-reranker-large
# cpu 或 cuda:0 等，与 PyTorch/SentenceTransformers 设备字符串一致
EMBEDDING_DEVICE=cpu

# Rerank 设备与候选池（Config C 生产默认）：
# RERANK_DEVICE=cuda 时启用 GPU FP16（质量守恒已验证）；cpu 为无 GPU 回退
RERANK_DEVICE=cpu
# rerank 候选池按 RRF 顺序截断的前 N 篇父文档；生产推荐 12，留空 = 全量
RERANK_POOL_TOP_N=12

# 意图识别用较快模型；生成仍由 LLM_MODEL 控制
INTENT_MODEL=qwen-turbo
LLM_MODEL=qwen-max

# LLM 流式中断/重试耗尽时输出的兜底文案（Task 19 B3）
LLM_FALLBACK_MESSAGE=抱歉，回答生成服务暂时不可用，请稍后重试。

# V2 运行态 Canonical Manifest。首次执行单文件入口时会以 frozen_assets 中的
# ingest_manifest_v1.jsonl 为基线原子创建；新增记录仅在 MySQL/Milvus 写入并核验成功后提交。
CANONICAL_MANIFEST_PATH=data/manifests/ingest_manifest_v2_live.jsonl

# COSINE 返回的是相似度；阈值表示允许偏差，直达需 similarity>=1-该值（0.01 -> >=0.99）
FAQ_DIRECT_DIST_THRESH=0.01
FAQ_LLM_DIST_THRESH=0.15
FAQ_TOP_K_FOR_LLM=3
LEGAL_RERANK_TOP_N=5

# 问答缓存 TTL（秒）；语料增量更新后由 corpus_version 翻面整体失效（Task 19 A6）
CACHE_TTL_SECONDS=3600

# 语义缓存（Task 23 两级缓存 L2）：exact 缓存的向量泛化，永久默认关闭（非待转正）
# 标定结论：BGE-M3 分离度倒挂——改述 0.9649 < 陷阱 0.9868，安全阈值区间不存在；
# 启用前需理解误命中风险（阈值 <0.97 会对「章/节」级近义问题返回错误答案）
# true 时 exact miss 后 embed 提前 + 向量相似度命中直出（演示实测 ttfb 9.4s -> 0.2s）
SEMANTIC_CACHE_ENABLED=false
# 余弦相似度命中阈值；离线标定结论：gold 集两两 max=0.9868 + 0.03 余度被 cap 至 0.97
# 标定依据：offline/scripts/calibrate_semantic_threshold.py（防「章/节」类近义陷阱）
SEMANTIC_CACHE_THRESHOLD=0.97
# 单版本 Hash 最大条目数；超出按写入时间驱逐最旧（条目 <1000，暴力打分无需 FAISS）
SEMANTIC_CACHE_MAX_ENTRIES=200

# 浏览器可跨域访问后端的 Origin 列表，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
